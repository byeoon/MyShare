<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Forbidden</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" type="image/x-icon" href="/img/favicon/favicon.ico">
  <link href="/css/app.css" rel="stylesheet">
</head>

<div class="hero bg-base-100 min-h-screen">
  <div class="hero-content flex-col lg:flex-row">
    <div>
      <h1 class="text-5xl font-bold text-center" style="font-size: 92px;">403</h1>
      <h1 class="text-2xl text-center">Access Forbidden</h1>
      <p class="py-6 text-center">
        You do not have permission or authorization to access this file or directory.
      </p>
      <br>
      <center> <a href="/dashboard.html"><button class="btn btn-neutral px-10">Go to Dashboard</button> </a></center>
    </div>
  </div>
</div>

</html>

<script>

  function logout() {
    localStorage.removeItem("token");
    localStorage.removeItem("userId");
    window.location.href = "/";
  }
</script>