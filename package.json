{
    "name": "myshare",
    "packageManager": "pnpm@11.3.0",
    "type": "module",
    "scripts": {
        "dev": "docker compose -f compose.yml -f compose.dev.yml up",
        "dev:build": "docker compose -f compose.yml -f compose.dev.yml build",
        "dev:nocache": "docker compose -f compose.yml -f compose.dev.yml build --no-cache",
        "dev:down": "docker compose -f compose.yml -f compose.dev.yml down",
        "dev:logs": "docker compose -f compose.yml -f compose.dev.yml logs -f",
        "build": "docker compose build",
        "up": "docker compose up -d",
        "down": "docker compose down",
        "restart": "docker compose restart",
        "logs": "docker compose logs -f",
        "ps": "docker compose ps",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:frontend": "eslint frontend --max-warnings=0",
        "lint:backend": "eslint backend --max-warnings=0",
        "lint:fix": "eslint . --fix",
        "check": "pnpm format:check && pnpm lint",
        "test": "pnpm --filter frontend --filter backend --parallel test",
        "test:frontend": "pnpm --dir frontend test",
        "test:backend": "pnpm --dir backend test",
        "frontend": "pnpm --filter frontend",
        "backend": "pnpm --filter backend",
        "frontend:dev": "pnpm --filter frontend dev",
        "frontend:build": "pnpm --filter frontend build",
        "frontend:preview": "pnpm --filter frontend preview",
        "backend:dev": "pnpm --filter backend dev",
        "backend:start": "pnpm --filter backend start",
        "db": "docker compose exec db",
        "db:psql": "docker compose exec db psql",
        "db:shell": "docker compose exec db sh"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.23.0",
        "globals": "^17.12.0",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^4.1.1",
        "typescript-eslint": "^8.70.0",
        "vitest": "^5.0.0"
    }
}
